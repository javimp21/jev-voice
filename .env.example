# Copy to .env for local CLI use; existing process environment values take precedence.
# Get a key at https://console.typesafe.ai/; never commit a real key.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_MIN_CONFIDENCE=0.8
AGENT_MAX_STEPS=8
# Optional observation-only remote visual grounding. Choose one provider explicitly.
VISUAL_PROVIDER=
OPENROUTER_API_KEY=
# Allowlisted alternatives: google/gemma-4-26b-a4b-it:free, inclusionai/ling-3.0-flash-vl:free
OPENROUTER_VISUAL_MODEL=google/gemma-4-26b-a4b-it:free
# Default deny restricts routing to non-collecting endpoints. Set allow only as an explicit privacy opt-in.
OPENROUTER_DATA_COLLECTION=deny
DEEPSEEK_API_KEY=
DEEPSEEK_VISUAL_MODEL=deepseek-flash
GEMINI_API_KEY=
GEMINI_VISUAL_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
# Used only as the one-shot Gemini visual fallback; may incur OpenAI API charges.
OPENAI_VISUAL_MODEL=gpt-5.6-luna
# One-shot speech transcription; reuses OPENAI_API_KEY and does not record to disk.
VOICE_STT_PROVIDER=openai
VOICE_MAX_DURATION_SECONDS=15
VOICE_STT_TIMEOUT_SECONDS=20
VISUAL_MODEL=gpt-6-astra
VISUAL_MAX_ELEMENTS=40
# Experimental debug-only semantic grounding limits (not used by run-agent).
VISUAL_DIRECTED_MAX_ELEMENTS=5
GEMINI_VISUAL_DIRECTED_MAX_OUTPUT_TOKENS=800
# Hard wall-clock deadline for each complete remote visual HTTP operation.
VISUAL_TIMEOUT_SECONDS=20
# Real-provider coordinate execution is intentionally unavailable in this release.
VISUAL_ACTIONS_ENABLED=false
OPEN_APP_ACTIVATION_TIMEOUT_SECONDS=3
VISUAL_READINESS_TIMEOUT_SECONDS=3
VISUAL_READINESS_POLL_INTERVAL_MS=200
# Local-only bounded settling before the single Phase-3 result-grounding request.
RESULT_READINESS_TIMEOUT_SECONDS=7
RESULT_READINESS_POLL_INTERVAL_MS=200
RESULT_SETTLE_QUIET_MS=1200
RESULT_TRANSITION_GRACE_MS=2500
RESULT_SIMPLIFICATION_RATIO_THRESHOLD=0.75
RESULT_SIMPLIFICATION_MIN_SIGNALS=2
